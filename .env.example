# Morax - modele de variables d'environnement.
# Copier vers .env.local (jamais commite). Aucune cle LLM cote edge ou client.

# ----- Supabase (Postgres + Auth + pgmq) -----
# Region UE obligatoire.
SUPABASE_URL=
SUPABASE_ANON_KEY=                 # client + routes serveur (RLS active)
SUPABASE_SERVICE_ROLE_KEY=         # routes serveur + worker UNIQUEMENT, jamais cote client
DATABASE_URL=                      # connexion directe Postgres (worker, migrations)

# Exposes au client (prefixe NEXT_PUBLIC). Jamais de secret ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Cloudflare R2 (medias, juridiction UE) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=morax-media
R2_ENDPOINT=                       # https://<account>.r2.cloudflarestorage.com

# ----- Telegram (capture + gate HIGH) -----
TELEGRAM_BOT_TOKEN=                # worker uniquement (envoi de messages)
TELEGRAM_WEBHOOK_SECRET=           # edge : verifie X-Telegram-Bot-Api-Secret-Token

# ----- Postmark (email entrant + sortant) -----
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=
POSTMARK_FROM_EMAIL=               # worker uniquement (envoi sortant devis/facture)

# ----- LLM (WORKER UNIQUEMENT - jamais edge/client) -----
# 2 fournisseurs au lancement : Anthropic direct + OpenRouter (passerelle).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ----- Langfuse (observabilite, Cloud UE) -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # endpoint UE

# ----- Push web VAPID (Chantier C, PWA) -----
# Optionnel : absent -> push simplement desactive (Telegram reste garanti).
# Generer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=                  # worker uniquement (envoi push)
VAPID_PRIVATE_KEY=                 # worker uniquement, SECRET
VAPID_SUBJECT=mailto:etienne@morax.app   # requis par la spec VAPID (mailto: ou https:)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # meme valeur que VAPID_PUBLIC_KEY, exposee au navigateur (cle publique, pas un secret)

# ----- Divers -----
NODE_ENV=development
MORAX_ENV=dev                      # dev | staging | production
MORAX_APP_URL=https://morax-app.vercel.app   # worker : referer OpenRouter. Bascule sur https://morax.app une fois delegue.
